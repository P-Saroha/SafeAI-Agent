# ── Groq LLM ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# Available Groq models (pick one):
#   openai/gpt-oss-120b        — most capable (default)
#   llama-3.1-70b-versatile    — faster, good for general tasks
#   llama-3.1-8b-instant       — fastest, lightweight
#   mixtral-8x7b-32768         — good for reasoning
GROQ_MODEL=openai/gpt-oss-120b

# ── LangSmith Tracing (optional) ──────────────────────────────────────────
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT="ChatBot-Project"

# ── Tools ─────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_key_here

# ── Memory ────────────────────────────────────────────────────────────────
LTM_POSTGRES_URI=postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable

# ── RAG Embeddings ────────────────────────────────────────────────────────
# "hash"   — offline, no API key needed (default, works out of the box)
# "google" — better quality, requires GOOGLE_API_KEY below
RAG_EMBEDDING_BACKEND=hash

# Only needed if RAG_EMBEDDING_BACKEND=google
# GOOGLE_API_KEY=your_google_api_key_here
